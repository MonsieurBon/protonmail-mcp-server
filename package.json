{
  "name": "protonmail-mcp-server",
  "version": "1.0.0",
  "description": "A Model Context Protocol (MCP) server for Proton Mail — read and organize email through Proton Bridge, without sending.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "protonmail-mcp-server": "dist/index.js"
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "Rune Højgaard de Blanck",
  "repository": {
    "type": "git",
    "url": "https://github.com/MonsieurBon/protonmail-mcp-server"
  },
  "keywords": ["mcp", "proton", "protonmail", "email", "imap", "claude", "model-context-protocol", "ai", "llm"],
  "bugs": {
    "url": "https://github.com/MonsieurBon/protonmail-mcp-server/issues"
  },
  "homepage": "https://github.com/MonsieurBon/protonmail-mcp-server#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "html-to-text": "^10.0.1",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.1",
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
